# Local development uses Vite proxy when these values are empty.
VITE_API_BASE_URL=
VITE_AUTH_BASE_URL=
VITE_ADMIN_MOCK_DATA=0
# Optional: usually derived from VITE_API_BASE_URL.
# VITE_PUBLIC_ASSET_BASE_URL=
# Optional workspace performance switch. Keep empty unless debugging very large boards.
# VITE_WORKSPACE_FLOW_ENABLE_CULLING=false

# Cloudflare Pages + Tunnel example:
# VITE_API_BASE_URL=https://api.example.com/api
# VITE_AUTH_BASE_URL=https://api.example.com
# VITE_PUBLIC_ASSET_BASE_URL=https://api.example.com
