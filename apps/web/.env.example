# Local development uses Vite proxy when these values are empty.
VITE_API_BASE_URL=
# Optional: usually derived from VITE_API_BASE_URL.
# VITE_PUBLIC_ASSET_BASE_URL=
# Optional temporary canvas performance timing probe for local profiling.
# VITE_CANVAS_PERF_PROBE=true

# Production is served through the same-origin gateway; leave both URL
# overrides empty so browser API and upload requests stay on ideaboard.art.
