/*
  Content-Security-Policy-Report-Only: script-src 'self' 'unsafe-inline' 'unsafe-eval'

/
  Content-Signal: ai-train=no, search=yes, ai-input=yes

/terms
  Content-Signal: ai-train=no, search=yes, ai-input=yes

/privacy-policy
  Content-Signal: ai-train=no, search=yes, ai-input=yes

/refund-policy
  Content-Signal: ai-train=no, search=yes, ai-input=yes

/acceptable-use
  Content-Signal: ai-train=no, search=yes, ai-input=yes

/user
  X-Robots-Tag: noindex, nofollow

/user/*
  X-Robots-Tag: noindex, nofollow

/admin
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/share
  X-Robots-Tag: noindex, nofollow

/share*
  X-Robots-Tag: noindex, nofollow

/api
  X-Robots-Tag: noindex, nofollow

/api/*
  X-Robots-Tag: noindex, nofollow
