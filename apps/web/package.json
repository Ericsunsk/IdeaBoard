{
  "name": "ideaboard-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "orval --config orval.config.ts",
    "api:check-generated": "tsx scripts/checkApiGeneratedDrift.ts",
    "api:surface:check": "tsx scripts/checkPublicApiSurface.ts",
    "api:surface:update": "tsx scripts/checkPublicApiSurface.ts --update",
    "admin-collection:check-contract": "tsx scripts/checkAdminCollectionStateContract.ts",
    "board-state:check-contract": "tsx scripts/checkBoardStateContractDrift.ts",
    "build": "vue-tsc -b && vite build && npm run bundle:size:check",
    "bundle:size:check": "tsx scripts/checkBundleSize.ts",
    "bundle:visualize": "ANALYZE=true vite build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . && npm run test:guardrails && npm run lint:user-copy && npm run lint:locale-parity && npm run lint:style-governance && npm run lint:naming-governance && npm run lint:import-boundaries && npm run lint:dependencies && npm run lint:duplication && npm run lint:knip && npm run api:surface:check && npm run audit:complexity",
    "lint:user-copy": "tsx scripts/checkUserCopyLocale.ts",
    "lint:locale-parity": "tsx scripts/checkLocaleParity.ts",
    "lint:import-boundaries": "tsx scripts/checkEslintImportBoundaries.ts",
    "lint:dependencies": "tsx scripts/checkDependencyBoundaries.ts",
    "lint:duplication": "jscpd src",
    "audit:complexity": "tsx scripts/checkComplexityHotspots.ts",
    "lint:style-governance": "tsx scripts/checkStyleGovernance.ts",
    "lint:naming-governance": "tsx scripts/checkNamingGovernance.ts",
    "lint:style": "stylelint \"src/**/*.{css,vue}\" --allow-empty-input",
    "lint:knip": "knip --include files,duplicates,dependencies,exports",
    "benchmark:canvas-interactions": "tsx scripts/canvasInteractionsBenchmark.ts",
    "preview": "vite preview",
    "smoke:user": "tsx scripts/userRouteSmoke.ts",
    "test": "vitest",
    "test:guardrails": "tsx scripts/checkTestGuardrails.ts && tsx scripts/checkBoardStateContractDrift.ts && npm run admin-collection:check-contract",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:accessibility": "tsx scripts/accessibilitySmoke.ts",
    "test:typecheck": "vue-tsc -p tsconfig.test.json --noEmit && vue-tsc -p tsconfig.test-node.json --noEmit",
    "test:run": "vitest run",
    "quality:check": "npm run format:check && npm run lint && npm run test:typecheck && npm run test:run && npm run build",
    "quality:full": "npm run quality:check && npm run lint:style && npm run api:check-generated && npm run test:browser && npm run test:accessibility"
  },
  "dependencies": {
    "@iconoir/vue": "^7.12.1",
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "^5.102.8",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.4.0",
    "better-auth": "^1.7.2",
    "chart.js": "^4.5.1",
    "compressorjs": "^1.3.0",
    "heic2any": "^0.0.4",
    "ofetch": "^1.5.1",
    "perfect-freehand": "1.2.3",
    "photoswipe": "^5.4.4",
    "primevue": "^4.5.5",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-advanced-cropper": "^2.8.9",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.10",
    "@vue/tsconfig": "^0.9.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.12",
    "jscpd": "^5.1.2",
    "knip": "^6.32.3",
    "msw": "^2.15.0",
    "orval": "^8.26.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "@vue/test-utils": "^2.5.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  }
}
