{
  "name": "ideaboard-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "orval --config orval.config.ts",
    "api:check-generated": "tsx scripts/check-api-generated-drift.ts",
    "board-state:check-contract": "tsx scripts/check-board-state-contract-drift.ts",
    "build": "vue-tsc -b && vite build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . && npm run test:guardrails && npm run lint:style-governance && npm run lint:import-boundaries",
    "lint:import-boundaries": "tsx scripts/check-eslint-import-boundaries.ts",
    "lint:style-governance": "tsx scripts/check-style-governance.ts",
    "lint:style": "stylelint \"src/**/*.{css,vue}\" --allow-empty-input",
    "benchmark:canvas-interactions": "tsx scripts/canvas-interactions-benchmark.ts",
    "preview": "vite preview",
    "smoke:user": "tsx scripts/user-route-smoke.ts",
    "test": "vitest",
    "test:guardrails": "tsx scripts/check-test-guardrails.ts && tsx scripts/check-board-state-contract-drift.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts --passWithNoTests",
    "test:typecheck": "vue-tsc -p tsconfig.test.json --noEmit && vue-tsc -p tsconfig.test-node.json --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@iconoir/vue": "^7.11.0",
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "^5.100.9",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.3.0",
    "better-auth": "^1.6.13",
    "chart.js": "^4.5.1",
    "compressorjs": "^1.3.0",
    "ofetch": "^1.5.1",
    "photoswipe": "^5.4.4",
    "primevue": "^4.5.5",
    "valibot": "^1.4.1",
    "vue": "^3.5.30",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "msw": "^2.14.6",
    "orval": "8.14.0",
    "playwright": "^1.61.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.13.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.0",
    "tailwindcss-primeui": "^0.6.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  }
}
