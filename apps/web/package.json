{
  "name": "ideaboard-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "orval --config orval.config.ts",
    "build": "vue-tsc -b && vite build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "css:audit": "tsx scripts/audit-css-migration.ts",
    "test:schema": "tsx src/features/boards/lib/canvasBoardStateSchema.spec.ts && tsx src/features/workspace/utils/flowSnapshotAdapter.schema.spec.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.100.9",
    "@vicons/ionicons5": "^0.13.0",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.3.0",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.15.2",
    "better-auth": "^1.3.12",
    "compressorjs": "^1.3.0",
    "naive-ui": "^2.44.1",
    "photoswipe": "^5.4.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "orval": "^8.9.1",
    "prettier": "^3.8.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.10",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "follow-redirects": "1.16.0",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  }
}
