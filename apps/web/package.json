{
  "name": "ideaboard-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "orval --config orval.config.ts",
    "api:check-generated": "tsx scripts/check-api-generated-drift.ts",
    "admin-collection:check-contract": "tsx scripts/check-admin-collection-state-contract.ts",
    "board-state:check-contract": "tsx scripts/check-board-state-contract-drift.ts",
    "build": "vue-tsc -b && vite build && npm run bundle:size:check",
    "bundle:size:check": "tsx scripts/check-bundle-size.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . && npm run test:guardrails && npm run lint:user-copy && npm run lint:locale-parity && npm run lint:style-governance && npm run lint:import-boundaries && npm run lint:knip",
    "lint:user-copy": "tsx scripts/check-user-copy-locale.ts",
    "lint:locale-parity": "tsx scripts/check-locale-parity.ts",
    "lint:import-boundaries": "tsx scripts/check-eslint-import-boundaries.ts",
    "lint:style-governance": "tsx scripts/check-style-governance.ts",
    "lint:style": "stylelint \"src/**/*.{css,vue}\" --allow-empty-input",
    "lint:knip": "knip --include files,duplicates,dependencies",
    "benchmark:canvas-interactions": "tsx scripts/canvas-interactions-benchmark.ts",
    "preview": "vite preview",
    "smoke:user": "tsx scripts/user-route-smoke.ts",
    "test": "vitest",
    "test:guardrails": "tsx scripts/check-test-guardrails.ts && tsx scripts/check-board-state-contract-drift.ts && npm run admin-collection:check-contract",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:typecheck": "vue-tsc -p tsconfig.test.json --noEmit && vue-tsc -p tsconfig.test-node.json --noEmit",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@iconoir/vue": "^7.12.1",
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "^5.102.8",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.4.0",
    "better-auth": "^1.6.23",
    "chart.js": "^4.5.1",
    "compressorjs": "^1.3.0",
    "heic2any": "^0.0.4",
    "ofetch": "^1.5.1",
    "perfect-freehand": "1.2.3",
    "photoswipe": "^5.4.4",
    "primevue": "^4.5.5",
    "valibot": "^1.4.2",
    "vue": "^3.5.42",
    "vue-advanced-cropper": "^2.8.9",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.6",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^4.1.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.12",
    "knip": "^6.32.3",
    "msw": "^2.15.0",
    "orval": "^8.26.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  }
}
