# IdeaBoard Auth local development environment.
# Copy to .env and fill the empty values. Startup fails fast listing every
# missing key; production additionally rejects placeholder and weak values.
#
# Listen surface (AUTH_HOST/AUTH_PORT/AUTH_TRUST_PROXY) is code-defaulted
# (127.0.0.1:6001, trustProxy loopback) and intentionally has no env here.

# Required shared secret for API/Auth internal routes. At least 32 random characters.
AUTH_INTERNAL_KEY=
# Internal Go API origin used to report successful login metadata.
# Container default is http://api:6000; local default below.
API_INTERNAL_URL=http://127.0.0.1:6000
APP_SECRETS_ENCRYPTION_KEY=
# Auth uses PUBLIC_ORIGIN as its canonical browser origin.
PUBLIC_ORIGIN=http://localhost:5173
# Production requires a random value of at least 32 characters.
# Development falls back to a marked dev-only value (rejected in production).
BETTER_AUTH_SECRET=

# PostgreSQL runtime connection (least-privilege role; never the owner).
PG_HOST=127.0.0.1
PG_PORT=5432
AUTH_PG_USER=ideaboard_auth
AUTH_PG_PASSWORD=
PG_DB=ideaboard
# Migration-only credentials are supplied separately; see docker/migration.env.example.
# Advanced database TLS mode. Defaults to disable.
# PG_SSLMODE=disable
