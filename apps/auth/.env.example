AUTH_PORT=6001
AUTH_HOST=127.0.0.1
# Fastify trustProxy setting. Use loopback for host reverse proxy, or Docker private CIDRs when it reaches Docker bridge upstreams.
# AUTH_TRUST_PROXY=loopback
# Required shared secret for API/Auth internal routes. Use at least 32 random characters.
AUTH_INTERNAL_KEY=
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Production requires a random value of at least 32 characters.
BETTER_AUTH_SECRET=
# Production BETTER_AUTH_URL must use https.
BETTER_AUTH_URL=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ideaboard_auth
DB_PASSWORD=replace-with-auth-runtime-db-password
DB_MIGRATION_USER=ideaboard
DB_MIGRATION_PASSWORD=replace-with-owner-db-password
DB_NAME=ideaboard
# Advanced database TLS mode. Defaults to disable.
# DB_SSLMODE=disable
