AUTH_PORT=6001
AUTH_HOST=127.0.0.1
AUTH_INTERNAL_KEY=replace-with-a-shared-internal-key
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Production-safe default. Set to true only when public/self-service signup is intended.
AUTH_REGISTRATION_ENABLED=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ideaboard
DB_PASSWORD=replace-with-your-db-password
DB_NAME=ideaboard
