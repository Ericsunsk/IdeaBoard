AUTH_PORT=6001
AUTH_HOST=127.0.0.1
# Fastify trustProxy setting. Use loopback for host Nginx, or Docker private CIDRs for compose gateway.
# AUTH_TRUST_PROXY=loopback
# Production requires a random value of at least 32 characters shared with the API service.
AUTH_INTERNAL_KEY=
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Production requires a random value of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ideaboard
DB_PASSWORD=replace-with-your-db-password
DB_NAME=ideaboard
# Advanced database TLS mode. Defaults to disable.
# DB_SSLMODE=disable
