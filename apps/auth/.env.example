AUTH_PORT=6001
AUTH_HOST=127.0.0.1
# Fastify trustProxy setting. Use loopback for host reverse proxy, or Docker private CIDRs when it reaches Docker bridge upstreams.
# AUTH_TRUST_PROXY=loopback
# Empty AUTH_INTERNAL_KEY is only allowed for local loopback development when AUTH_INSECURE_DEV=1.
# AUTH_INSECURE_DEV=1
# Production requires a random value of at least 32 characters shared with the API service.
AUTH_INTERNAL_KEY=
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Production requires a random value of at least 32 characters.
BETTER_AUTH_SECRET=
# Production BETTER_AUTH_URL must use https.
BETTER_AUTH_URL=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ideaboard
DB_PASSWORD=replace-with-your-db-password
DB_NAME=ideaboard
# Advanced database TLS mode. Defaults to disable.
# DB_SSLMODE=disable
