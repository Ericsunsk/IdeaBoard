{
  "name": "ideaboard-auth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "better-auth migrate --config ./src/auth.ts --yes",
    "migrate:dist": "better-auth migrate --config ./dist/auth.js --yes"
  },
  "dependencies": {
    "better-auth": "^1.3.12",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/express": "^4.17.23",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.17.24"
  }
}
