{
  "name": "ideaboard-auth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:dist": "node dist/migrate.js"
  },
  "dependencies": {
    "better-auth": "1.6.13",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
