{
  "name": "ideaboard-auth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node node_modules/@better-auth/cli/dist/index.mjs migrate --config ./src/auth.ts --yes",
    "migrate:dist": "node dist/migrate.js"
  },
  "dependencies": {
    "better-auth": "^1.6.13",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@types/pg": "^8.20.0",
    "@types/node": "^25.9.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.17.24"
  }
}
