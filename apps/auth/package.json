{
  "name": "ideaboard-auth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-email-templates.mjs",
    "contract:generate": "node scripts/generate-internal-contract.mjs",
    "contract:check": "node scripts/generate-internal-contract.mjs --check",
    "architecture:check": "node scripts/check-architecture.mjs",
    "test": "npm run contract:check && npm run architecture:check && tsx --test \"src/**/*.test.ts\"",
    "lint": "prettier . --check",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:dist": "node dist/migrate.js"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
