{
  "name": "ideaboard-realtime",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "lint": "prettier . --check",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "lib0": "^0.2.119",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
