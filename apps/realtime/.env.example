# IdeaBoard Realtime sidecar local development environment.
# Copy to .env and fill the empty values. Startup fails fast listing every
# missing key; production additionally rejects placeholder and weak values.
#
# Listen surface (RT_HOST/RT_PORT, defaults 127.0.0.1:6002) and the Y.Doc
# collaboration knobs (RT_Y_COMPACT_EVERY=50, RT_Y_PERSIST_RETRIES=5) are code
# defaults in src/infrastructure/env.ts and intentionally have no env here.

# HMAC-SHA256 secret for ticket signing. Must equal the Go API RT_TICKET_SECRET
# that mints tickets. At least 32 random characters in production.
# Generate with: openssl rand -base64 32
RT_TICKET_SECRET=
# Single shared internal key sent as X-Internal-Key to the Go API admit
# endpoint. Must equal the Go/auth AUTH_INTERNAL_KEY value.
AUTH_INTERNAL_KEY=
# Internal Go API origin used for admit, Y update persistence, and compactions.
# Container default is http://api:6000; local default below.
API_INTERNAL_URL=http://127.0.0.1:6000
