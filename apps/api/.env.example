DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ideaboard_api
DB_PASSWORD=replace-with-api-runtime-db-password
DB_MIGRATION_USER=ideaboard
DB_MIGRATION_PASSWORD=replace-with-owner-db-password
DB_NAME=ideaboard
DB_SSLMODE=disable

# Advanced database startup tuning. Defaults are usually enough.
# DB_CONNECT_MAX_RETRIES=60
# DB_CONNECT_RETRY_INTERVAL_MS=1000

APP_PORT=6000
APP_HOST=
# Optional: override Gin mode with debug / release / test. Defaults to release.
# APP_GIN_MODE=
# Comma-separated allowed browser origins for non-production CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional outbound proxy for backend requests to model providers.
# Example for local Clash/Surge: HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

AUTH_SERVICE_BASE_URL=http://127.0.0.1:6001
AUTH_INTERNAL_KEY=

# Required AES-256-GCM master key for API/account/storage secrets.
# Generate with: openssl rand -base64 32
APP_SECRETS_ENCRYPTION_KEY=

# Advanced auth service timeout. Defaults to 5 seconds.
# AUTH_SERVICE_TIMEOUT_SECONDS=5

# Advanced River task runtime tuning. Defaults are usually enough.
# RIVER_WORKER_CONCURRENCY=5
# RIVER_TASK_TIMEOUT_SECONDS=180
# RIVER_NO_CAPACITY_RETRY_SECONDS=5
# RIVER_MAX_RETRY=25

# Optional NATS JetStream event bus. Leave NATS_URL empty to use in-process SSE fanout only.
# River remains the task queue; JetStream carries task status events and audit/realtime integrations.
# NATS_URL=nats://127.0.0.1:4222
# NATS_EVENT_BUS_ENABLED=true
# NATS_STREAM_NAME=IDEABOARD_EVENTS
# NATS_SUBJECT_PREFIX=ideaboard
# NATS_CONSUMER_NAME=
# NATS_RETENTION_DAYS=7
# NATS_CONNECT_TIMEOUT_SECONDS=5
# NATS_REQUEST_TIMEOUT_SECONDS=5
# NATS_DRAIN_TIMEOUT_SECONDS=2

# Server log file path. Defaults to server.log in the working directory.
# Set to an absolute path for production (e.g. /var/log/ideaboard/server.log).
# Set to "none" to disable file logging (stderr only).
# APP_LOG_FILE=server.log
