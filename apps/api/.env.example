DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ideaboard_api
DB_PASSWORD=replace-with-api-runtime-db-password
DB_NAME=ideaboard
DB_SSLMODE=disable

# Migration-only credentials live in docker/migration.env.example and must not
# be loaded by the long-running API process.
# The migrate command and startup finalization read them when set:
# DB_MIGRATION_USER=ideaboard_owner
# DB_MIGRATION_PASSWORD=replace-with-migration-db-password

APP_PORT=6000
APP_HOST=
# Dedicated Prometheus listener. Keep loopback-only unless the network is private.
METRICS_ADDR=127.0.0.1:9091
# Comma-separated allowed browser origins for non-production CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reverse proxies trusted for X-Forwarded-For ClientIP (rate limiting).
# Production behind Nginx/Cloudflare must list the proxy IPs/CIDRs here;
# defaults to loopback only so direct clients cannot spoof forwarded headers.
# APP_TRUSTED_PROXIES=127.0.0.1,::1,10.0.0.0/8
# Runtime environment name. Defaults to development; production gates
# (strict CORS, trusted-proxy enforcement, secret validation) key off it.
# APP_ENV=development
# Canonical public origin. API_BASE_URL is optional and overrides it for local
# development or a deployment with a separate API host.
PUBLIC_ORIGIN=http://localhost:5173
# API_BASE_URL=http://localhost:6000
# Optional outbound proxy for backend requests to model providers.
# Example for local Clash/Surge: HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

AUTH_SERVICE_BASE_URL=http://127.0.0.1:6001
AUTH_INTERNAL_KEY=

# Required AES-256-GCM master key for API/account/storage secrets.
# Generate with: openssl rand -base64 32
APP_SECRETS_ENCRYPTION_KEY=
# 首次使用后数据库永久绑定 fingerprint；误更换会 fail closed。
CREDITS_WELCOME_IDENTITY_KEY=
# JSON keyring. Each key is base64 and must decode to at least 32 bytes.
# {"current":{"version":"v1","key":"<base64>"},"previous":null}
REWARDS_CODE_HMAC_KEYS=

# Optional NATS JetStream event bus. Leave NATS_PASSWORD empty
# to use in-process SSE fanout only.
# River remains the task queue; JetStream carries task status events and audit/realtime integrations.
# Derive nats://ideaboard:<password>@<host>:<port> from the split below.
# NATS_PASSWORD=
# NATS_HOST=127.0.0.1
# NATS_PORT=4222
# NATS_EVENT_BUS_ENABLED=true

# River worker concurrency. Retry/timeout policy is code-owned; NATS retention is fixed at 7 days.
RIVER_WORKER_CONCURRENCY=5
# Database connection budget. One API instance holds DB_POOL_MAX_OPEN (sql.DB)
# + RIVER_POOL_MAX_CONNS (River pgxpool); keep the sum under PostgreSQL
# max_connections (default 100) with headroom for migrations and CLIs.
# Idle counts above the open ceiling clamp down; out-of-range values fall back
# to defaults and fail production startup (see Config.InvalidEnv).
# DB_POOL_MAX_OPEN=25
# DB_POOL_MAX_IDLE=10
# DB_POOL_MAX_LIFETIME_MINUTES=30
# DB_POOL_MAX_IDLE_MINUTES=5
# RIVER_POOL_MAX_CONNS=10
# RIVER_POOL_MIN_CONNS=1
# Raw task row lifetime in days (terminal tasks only; statistics aggregates and
# financial facts are retained independently). Must stay aligned with the
# admin observability window.
# TASK_RETENTION_DAYS=7
# Local storage root for the builtin-local profile (uploads, derivatives,
# staged bytes). S3-compatible profiles ignore it.
# STORAGE_LOCAL_ROOT=./var/uploads
# imgproxy URL signing (hex). Empty means unsigned URLs; set both in any
# environment serving non-public derivatives through imgproxy.
# IMGPROXY_KEY=
# IMGPROXY_SALT=
# AI Gateway (Cloudflare) has no env keys by design: the gateway token and
# gateway identity live in Admin settings (/api/admin/settings/ai-gateway),
# encrypted at rest with APP_SECRETS_ENCRYPTION_KEY. Dev and prod are separate
# databases, so per-environment isolation falls out of deployment topology.
# Private outbound destinations are managed in Admin System Settings.

# init-admin provisioning inputs. Only the init-admin command requires them.
# INIT_ADMIN_EMAIL=admin@example.com
# INIT_ADMIN_DISPLAY_NAME=Admin
# INIT_ADMIN_PASSWORD=replace-with-admin-password

# Atlas migration tooling. Only the migrate command and schema-release checks
# use them; unset values resolve to the documented defaults.
# ATLAS_BINARY=atlas
# ATLAS_MIGRATIONS_DIR=file://internal/db/migrations

# Healthcheck CLI override. Unset derives http://127.0.0.1:<APP_PORT>/api/health.
# HEALTHCHECK_URL=http://127.0.0.1:6000/api/health
