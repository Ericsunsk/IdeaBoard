# IdeaBoard API local development environment.
# Copy to .env and fill the empty values. Startup fails fast listing every
# missing key (Config.ValidateRequired); production additionally rejects
# placeholder and weak values.
#
# Tuning knobs (pool sizes, retention windows, CORS, metrics, storage root,
# Atlas paths, admin seed) are code defaults in
# internal/platform/config/config.go and intentionally have no env here.
# Only set them if you are changing deploy topology.

# PostgreSQL runtime connection (least-privilege role; never the owner).
PG_HOST=127.0.0.1
PG_PORT=5432
API_PG_USER=ideaboard_api
API_PG_PASSWORD=
PG_DB=ideaboard
PG_SSLMODE=disable

# Migration-only credentials live in docker/migration.env.example and must not
# be loaded by the long-running API process.
# The migrate command and startup finalization read PG_MIGRATION_* when set.

# Canonical public origin (single origin for browser navigation, webhooks
# and server-side asset addresses; same-origin Gateway by design).
PUBLIC_ORIGIN=http://localhost:5173

# Internal Auth service origin (single canonical name; compose uses http://auth:6001).
AUTH_INTERNAL_URL=http://127.0.0.1:6001
# Shared secret for API/Auth internal routes. At least 32 random characters.
# Required at production startup; missing in development disables internal routes.
AUTH_INTERNAL_KEY=

# Required AES-256-GCM master key for API/account/storage secrets.
# Generate with: openssl rand -base64 32
APP_SECRETS_ENCRYPTION_KEY=
# 首次使用后数据库永久绑定 fingerprint；误更换会 fail closed。
CREDITS_WELCOME_IDENTITY_KEY=
# JSON keyring. Each key is base64 and must decode to at least 32 bytes.
# {"current":{"version":"v1","key":"<base64>"},"previous":null}
REWARDS_CODE_HMAC_KEYS=
# Board presence ticket HMAC secret (Y.js collaboration). Empty fails the
# realtime-ticket endpoint closed with 500 (no fallback default) and fails
# production startup via ValidateRequired; development only warns.
# Must equal the realtime sidecar RT_TICKET_SECRET.
# Generate with: openssl rand -base64 32
RT_TICKET_SECRET=

# Required NATS JetStream event bus for the local Compose stack and
# production (compose.local.yml / compose.yml both fail fast without
# NATS_PASSWORD; code falls back to in-process SSE fanout only when running
# the API binary without NATS, e.g. unit tests).
# River remains the task queue; JetStream carries task status events and audit/realtime integrations.
# Host development uses 127.0.0.1:4222; production uses nats:4222.
# Both Compose topologies authenticate as ideaboard with the same password.
# 选边记录（2026-10-20）：本地 NATS 按必填对齐 compose，文档不再标可选。
# NATS_PASSWORD=

# River worker concurrency (default 5, range 1-64). Restart to apply.
RIVER_WORKER_CONCURRENCY=5

# Process role (ADR-0021): all = HTTP + workers in one process (local
# default); http-only / worker-only for split deployments (compose pins this).
# API_MODE=all
# Runtime environment name. Defaults to development; production gates
# (strict CORS, trusted-proxy enforcement, secret validation) key off it.
# APP_ENV=development

# imgproxy signs internal rendering requests. Both services require matching,
# distinct 64-character hex keys; startup rejects empty or weak bindings.
# Generate with: openssl rand -hex 32
# IMGPROXY_KEY=
# IMGPROXY_SALT=
# AI image egress is the sole ai-proxy Worker service (no direct
# provider egress from the API). WORKER_BASE_URL + INTERNAL_SECRET are
# required: missing values fail every image task closed before any send.
# (联调时把 WORKER_BASE_URL 换成真地址；本轨用 httptest 假 Worker 独立验证。)
# WORKER_BASE_URL=
# INTERNAL_SECRET=
# The Admin model library (catalog + custom params) stays operator-managed
# in system settings; the Worker reads no Admin gateway credentials.
# Resilience knobs below are env-only with fail-closed defaults and
# never carry secrets:
# WORKER_PER_MODEL_LIMIT caps concurrent in-flight sends per model
# (default 8, range 1-64). WORKER_BREAKER_COOLDOWN_SECONDS bounds an
# open per-model breaker before a half-open probe (default 30, range 5-300).
# WORKER_BREAKER_FAILURE_RATE is the windowed failure/slow-call rate
# percent that opens the breaker (default 50, range 1-100).

# init-admin provisioning inputs. Only the init-admin command requires them.
# INIT_ADMIN_DISPLAY_NAME is optional: empty defaults to the INIT_ADMIN_EMAIL
# local part (before @); Better Auth normalizeDisplayName still applies.
# INIT_ADMIN_EMAIL=admin@example.com
# INIT_ADMIN_DISPLAY_NAME=Admin
# INIT_ADMIN_PASSWORD=replace-with-admin-password

# Healthcheck CLI override. Unset defaults to http://127.0.0.1:6000/api/health
# (server listener is the hardcoded 0.0.0.0:6000 code constant).
# HEALTHCHECK_URL=http://127.0.0.1:6000/api/health
