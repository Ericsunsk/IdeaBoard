DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ideaboard
DB_PASSWORD=replace-with-your-db-password
DB_NAME=ideaboard
DB_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_AUTH=

APP_PORT=6000
APP_HOST=
# Optional: override Gin mode with debug / release / test. Defaults to release.
APP_GIN_MODE=
# Comma-separated allowed browser origins for non-production CORS.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public frontend base URL, used for share links. Example: https://app.example.com
APP_PUBLIC_BASE_URL=
# Public asset/API origin for local /uploads URLs and upstream model callbacks.
# In Cloudflare Pages + Tunnel deployments this is usually https://api.example.com.
APP_PUBLIC_ASSET_BASE_URL=
# Optional outbound proxy for backend requests to model providers.
# Example for local Clash/Surge: HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

AUTH_SERVICE_BASE_URL=http://127.0.0.1:6001
AUTH_SERVICE_INTERNAL_KEY=
AUTH_SERVICE_TIMEOUT_SECONDS=5

# Server log file path. Defaults to server.log in the working directory.
# Set to an absolute path for production (e.g. /var/log/ideaboard/server.log).
# Set to "none" to disable file logging (stderr only).
# APP_LOG_FILE=server.log
