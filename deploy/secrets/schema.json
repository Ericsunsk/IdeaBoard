{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "POSTGRES_PASSWORD",
    "API_DB_PASSWORD",
    "AUTH_DB_PASSWORD",
    "AUTH_INTERNAL_KEY",
    "APP_SECRETS_ENCRYPTION_KEY",
    "CREDITS_WELCOME_IDENTITY_KEY",
    "REWARDS_CODE_HMAC_KEYS",
    "BETTER_AUTH_SECRET",
    "NATS_PASSWORD",
    "IMGPROXY_KEY",
    "IMGPROXY_SALT"
  ],
  "properties": {
    "POSTGRES_PASSWORD": { "type": "string", "minLength": 32 },
    "API_DB_PASSWORD": { "type": "string", "minLength": 32 },
    "AUTH_DB_PASSWORD": { "type": "string", "minLength": 32 },
    "AUTH_INTERNAL_KEY": { "type": "string", "minLength": 32 },
    "APP_SECRETS_ENCRYPTION_KEY": { "type": "string", "minLength": 43 },
    "CREDITS_WELCOME_IDENTITY_KEY": { "type": "string", "minLength": 43 },
    "REWARDS_CODE_HMAC_KEYS": { "type": "string", "minLength": 1 },
    "BETTER_AUTH_SECRET": { "type": "string", "minLength": 32 },
    "NATS_PASSWORD": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{32,}$" },
    "IMGPROXY_KEY": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "IMGPROXY_SALT": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}
