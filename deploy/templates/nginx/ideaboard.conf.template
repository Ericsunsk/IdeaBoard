server {
    # Retired cross-origin API hostname must never fall through to the app vhost.
    # If TLS is terminated by an outer Nginx/NPM vhost, duplicate this reject
    # server_name there as well; HTTPS must not fall through to primary.
    listen 80;
    server_name ${NGINX_LEGACY_API_SERVER_NAME};
    return 444;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    ${NGINX_REAL_IP_INCLUDE_DIRECTIVE}

    client_max_body_size 50m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    root ${NGINX_WEB_ROOT};
    index index.html;

    # Same-origin gateway contract: mark every response on /api/**, /api/auth/**,
    # and SSE routes as uncacheable, and disable proxy buffering on
    # SSE/streaming routes, so authenticated and state-changing traffic can never
    # be cached by an intermediary. (proxy_cache is not configured anywhere; this
    # is response-header-only enforcement.) Media bytes ride the same /api/**
    # surface (v1 media-assets content/derivatives, public avatar/logo routes):
    # no path outside /api/** is proxied to the API.

    location = /api/health {
        proxy_pass ${NGINX_API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    location = /api/auth/health {
        proxy_pass ${NGINX_AUTH_HEALTH_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # Better Auth admin plugin surface. Auth Service is also directly reachable
    # by the Go API on the internal network (AUTH_SERVICE_BASE_URL), which is
    # how impersonation starts; the browser must never reach these endpoints
    # directly. Every high-risk action here (remove-user, set-role, ban,
    # set-user-password, revoke-session, ...) already has an internal-key
    # authenticated route under /internal/users/* on the Auth Service, and
    # the only browser-needed endpoint is ending an impersonation, which is
    # the single exception below. A plain `return 403` keeps this location
    # free of add_header directives, so it inherits the server-level security
    # headers instead of replacing them.
    location ~ ^/api/auth/admin/(?!stop-impersonating$) {
        return 403;
    }

    location /api/auth/ {
        proxy_pass ${NGINX_AUTH_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    # Workspace task routes (long-polling JSON under
    # /api/v1/workspaces/{workspace_id}/tasks*): generous timeouts, never
    # buffered or cached.
    location ~ ^/api/v1/workspaces/[^/]+/tasks(/|$) {
        proxy_pass ${NGINX_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 10m;
        proxy_send_timeout 10m;
        add_header X-Accel-Buffering "no" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Workspace event stream (SSE) over
    # /api/v1/workspaces/{workspace_id}/events: flush state transitions promptly.
    location ~ ^/api/v1/workspaces/[^/]+/events(/|$) {
        proxy_pass ${NGINX_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header X-Accel-Buffering "no" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Realtime presence sidecar (y-websocket, awareness-only): single-replica
    # upstream with WebSocket upgrade passthrough. Streaming timeouts mirror
    # the workspace tasks (10m) / events (1h) style; presence sockets stay
    # open, so the events-style 1h bound applies. Document writes never flow
    # here (ADR-0019); board persistence stays on /api/** under ADR-0006
    # optimistic revision + 409.
    location = /realtime {
        proxy_pass ${NGINX_REALTIME_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header X-Accel-Buffering "no" always;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass ${NGINX_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Pragma "no-cache" always;
    }

    location / {
        ${NGINX_ROOT_DIRECTIVE};
    }
}
