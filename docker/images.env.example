# GHCR 镜像。受信部署入口从签名 bundle 的 release manifest 写入完整 digest 引用。
# 不支持从 mutable tag 自动解析；以下占位值仅用于首次生成配置。
IDEABOARD_API_IMAGE=ghcr.io/your-github-owner/your-repo/ideaboard-api@sha256:replace-with-api-image-digest
IDEABOARD_API_MIGRATE_IMAGE=ghcr.io/your-github-owner/your-repo/ideaboard-api-migrate@sha256:replace-with-api-migrate-image-digest
IDEABOARD_AUTH_IMAGE=ghcr.io/your-github-owner/your-repo/ideaboard-auth@sha256:replace-with-auth-image-digest
IDEABOARD_AUTH_MIGRATE_IMAGE=ghcr.io/your-github-owner/your-repo/ideaboard-auth-migrate@sha256:replace-with-auth-migrate-image-digest
IDEABOARD_REALTIME_IMAGE=ghcr.io/your-github-owner/your-repo/ideaboard-realtime@sha256:replace-with-realtime-image-digest
