{
  "openapi": "3.0.3",
  "info": {
    "title": "IdeaBoard Auth Internal API",
    "version": "1.0.0",
    "description": "Canonical private HTTP contract between the Go API and Better Auth service."
  },
  "servers": [
    {
      "url": "http://localhost:6001"
    }
  ],
  "security": [
    {
      "InternalKey": []
    }
  ],
  "paths": {
    "/internal/session": {
      "get": {
        "operationId": "validateSession",
        "summary": "Validate a Better Auth session forwarded by the Go API",
        "responses": {
          "200": {
            "description": "Trusted or untrusted session identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/users/ensure": {
      "post": {
        "operationId": "ensureUser",
        "summary": "Provision or reuse a trusted canonical identity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnsureUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provisioned trusted identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnsureUserEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/users/emails": {
      "post": {
        "operationId": "getUserEmails",
        "summary": "Read Auth emails for a bounded set of user IDs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetUserEmailsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auth emails resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserEmailsEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/users/states": {
      "post": {
        "operationId": "getUserStates",
        "summary": "Read Auth role and ban state for a bounded set of user IDs",
        "description": "Read-only batch endpoint for the Identity admin reconciliation job (dry-run alerting). Returns role, banned flag, ban reason and ban expiry per Auth identity; unknown IDs are omitted, never fabricated.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetUserStatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auth states resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserStatesEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/users/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/AuthUserID"
        }
      ],
      "delete": {
        "operationId": "deleteUser",
        "summary": "Delete an Auth identity and its Auth-owned records",
        "responses": {
          "200": {
            "description": "Identity deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteUserEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/users/{id}/role": {
      "parameters": [
        {
          "$ref": "#/components/parameters/AuthUserID"
        }
      ],
      "put": {
        "operationId": "setUserRole",
        "summary": "Set an Auth identity role",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetUserRoleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetUserRoleEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/users/ban": {
      "post": {
        "operationId": "banUser",
        "summary": "Ban an Auth identity and revoke its sessions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BanUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identity banned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanUserEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/users/unban": {
      "post": {
        "operationId": "unbanUser",
        "summary": "Unban an Auth identity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identity unbanned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnbanUserEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/users/revoke-sessions": {
      "post": {
        "operationId": "revokeUserSessions",
        "summary": "Revoke every session for an Auth identity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessions revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevokeUserSessionsEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/internal/mail/config": {
      "get": {
        "operationId": "getMailConfig",
        "summary": "Read the transactional mail configuration summary",
        "responses": {
          "200": { "$ref": "#/components/responses/MailConfigSuccess" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "put": {
        "operationId": "updateMailConfig",
        "summary": "Update the transactional mail configuration",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MailConfigRequest" } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/MailConfigSuccess" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "delete": {
        "operationId": "clearMailConfig",
        "summary": "Clear the transactional mail configuration",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActorRequest" } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/MailMutationSuccess" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/internal/mail/config/test": {
      "post": {
        "operationId": "sendMailConfigTest",
        "summary": "Send a transactional mail configuration test",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MailTestRequest" } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/MailMutationSuccess" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/internal/social-providers/capabilities": {
      "get": {
        "operationId": "getSocialProviderCapabilities",
        "summary": "Read configured social identity provider capabilities",
        "responses": {
          "200": { "$ref": "#/components/responses/SocialCapabilitiesSuccess" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/internal/social-providers/{provider}": {
      "parameters": [{ "$ref": "#/components/parameters/SocialProvider" }],
      "get": {
        "operationId": "getSocialProvider",
        "summary": "Read a social identity provider configuration summary",
        "responses": {
          "200": { "$ref": "#/components/responses/SocialProviderSuccess" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "put": {
        "operationId": "updateSocialProvider",
        "summary": "Update a social identity provider configuration",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialProviderRequest" } } } },
        "responses": {
          "200": { "$ref": "#/components/responses/SocialProviderSuccess" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InternalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Key"
      }
    },
    "parameters": {
      "AuthUserID": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        }
      },
      "SocialProvider": {
        "name": "provider",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Internal key or session rejected",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "Auth identity not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Conflict": {
        "description": "Identity conflicts with requested trusted state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "InternalError": {
        "description": "Auth dependency or repository failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Auth dependency unavailable",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "MailConfigSuccess": {
        "description": "Mail configuration summary",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MailConfigEnvelope" }
          }
        }
      },
      "MailMutationSuccess": {
        "description": "Mail mutation completed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/MailMutationEnvelope" }
          }
        }
      },
      "SocialProviderSuccess": {
        "description": "Social provider configuration summary",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SocialProviderEnvelope" }
          }
        }
      },
      "SocialCapabilitiesSuccess": {
        "description": "Social provider capabilities",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SocialCapabilitiesEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "ActorRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id"],
        "properties": { "actor_id": { "type": "integer", "format": "int64", "minimum": 1, "x-go-name": "ActorID" } }
      },
      "MailConfigRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_name", "from_email", "actor_id"],
        "properties": {
          "api_key": { "type": "string", "minLength": 1, "x-go-name": "APIKey" },
          "from_name": { "type": "string", "minLength": 1 },
          "from_email": { "type": "string", "minLength": 1 },
          "reply_to": { "type": "string" },
          "actor_id": { "type": "integer", "format": "int64", "minimum": 1, "x-go-name": "ActorID" }
        }
      },
      "MailTestRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipient", "actor_id"],
        "properties": {
          "recipient": { "type": "string", "minLength": 1 },
          "actor_id": { "type": "integer", "format": "int64", "minimum": 1, "x-go-name": "ActorID" }
        }
      },
      "MailConfigSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["configured", "api_key_configured", "from_name", "from_email", "reply_to", "config_version", "readiness", "updated_at", "last_tested_at", "last_test_error_code"],
        "properties": {
          "configured": { "type": "boolean" },
          "api_key_configured": { "type": "boolean" },
          "from_name": { "type": "string" },
          "from_email": { "type": "string" },
          "reply_to": { "type": "string" },
          "config_version": { "type": "integer" },
          "readiness": { "type": "string", "enum": ["not_configured", "not_tested", "ready", "unavailable"] },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true },
          "last_tested_at": { "type": "string", "format": "date-time", "nullable": true },
          "last_test_error_code": { "type": "string", "nullable": true }
        }
      },
      "MailConfigEnvelope": {
        "type": "object", "additionalProperties": false, "required": ["code", "msg", "data"],
        "properties": { "code": { "type": "integer", "enum": [0] }, "msg": { "type": "string" }, "data": { "$ref": "#/components/schemas/MailConfigSummary" } }
      },
      "MailMutationEnvelope": {
        "type": "object", "additionalProperties": false, "required": ["code", "msg", "data"],
        "properties": { "code": { "type": "integer", "enum": [0] }, "msg": { "type": "string" }, "data": { "type": "object", "additionalProperties": false, "required": ["ok"], "properties": { "ok": { "type": "boolean", "enum": [true] } } } }
      },
      "SocialProviderRequest": {
        "type": "object", "additionalProperties": false, "required": ["enabled", "client_id"],
        "properties": { "enabled": { "type": "boolean" }, "client_id": { "type": "string" }, "client_secret": { "type": "string", "minLength": 1 } }
      },
      "SocialProviderSummary": {
        "type": "object", "additionalProperties": false,
        "required": ["provider", "enabled", "configured", "available", "client_id", "client_secret_configured", "scopes", "config_version", "callback_url", "updated_at"],
        "properties": {
          "provider": { "type": "string", "minLength": 1, "maxLength": 64 }, "enabled": { "type": "boolean" }, "configured": { "type": "boolean" }, "available": { "type": "boolean" }, "client_id": { "type": "string" }, "client_secret_configured": { "type": "boolean" }, "scopes": { "type": "array", "items": { "type": "string" } }, "config_version": { "type": "integer" }, "callback_url": { "type": "string" }, "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "SocialProviderEnvelope": {
        "type": "object", "additionalProperties": false, "required": ["code", "msg", "data"],
        "properties": { "code": { "type": "integer", "enum": [0] }, "msg": { "type": "string" }, "data": { "$ref": "#/components/schemas/SocialProviderSummary" } }
      },
      "SocialCapabilities": {
        "type": "object", "additionalProperties": false, "required": ["social"],
        "properties": { "social": { "type": "object", "additionalProperties": { "type": "boolean" } }, "providers": { "type": "array", "items": { "$ref": "#/components/schemas/SocialProviderCapability" } } }
      },
      "SocialProviderCapability": {
        "type": "object", "additionalProperties": false, "required": ["provider", "label", "available"],
        "properties": { "provider": { "type": "string", "minLength": 1, "maxLength": 64 }, "label": { "type": "string" }, "available": { "type": "boolean" } }
      },
      "SocialCapabilitiesEnvelope": {
        "type": "object", "additionalProperties": false, "required": ["code", "msg", "data"],
        "properties": { "code": { "type": "integer", "enum": [0] }, "msg": { "type": "string" }, "data": { "$ref": "#/components/schemas/SocialCapabilities" } }
      },
      "AuthRole": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ]
      },
      "TrustedClaimIdentityKind": {
        "type": "string",
        "enum": [
          "canonical_email"
        ]
      },
      "SessionClaimIdentityKind": {
        "type": "string",
        "enum": [
          "canonical_email",
          "untrusted"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "msg"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "msg": {
            "type": "string"
          }
        }
      },
      "SessionIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
        "auth_user_id",
        "email",
        "display_name",
          "claim_identity",
          "claim_identity_kind",
          "claim_identity_verified"
        ],
        "properties": {
          "auth_user_id": {
            "type": "string",
            "x-go-name": "AuthUserID"
          },
          "email": {
            "type": "string"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "avatar": {
            "type": "string",
            "maxLength": 2048
          },
          "claim_identity": {
            "type": "string"
          },
          "claim_identity_kind": {
            "$ref": "#/components/schemas/SessionClaimIdentityKind"
          },
          "claim_identity_verified": {
            "type": "boolean"
          }
        }
      },
      "ProvisionedAuthUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
        "auth_user_id",
        "display_name",
          "email",
          "claim_identity",
          "claim_identity_kind",
          "claim_identity_verified",
          "role",
          "existing"
        ],
        "properties": {
          "auth_user_id": {
            "type": "string",
            "x-go-name": "AuthUserID"
          },
        "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string"
          },
          "claim_identity": {
            "type": "string"
          },
          "claim_identity_kind": {
            "$ref": "#/components/schemas/TrustedClaimIdentityKind"
          },
          "claim_identity_verified": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "role": {
            "$ref": "#/components/schemas/AuthRole"
          },
          "existing": {
            "type": "boolean"
          }
        }
      },
      "EnsureUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
        "email",
        "display_name",
        "password",
          "allow_existing",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
